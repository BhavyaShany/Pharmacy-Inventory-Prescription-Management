# Copy this file to .env and change SECRET_KEY before running.
# The defaults below match docker-compose.yml (MySQL published on host port 3307).
DATABASE_URL=mysql+pymysql://pharmacy_user:pharmacy_pass@localhost:3307/pharmacy_db
SECRET_KEY=replace-this-with-a-long-random-string
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173
