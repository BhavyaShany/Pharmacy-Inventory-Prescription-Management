# Normalise text files so the project behaves the same in any editor and OS.
* text=auto eol=lf

*.py   text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.yml  text eol=lf
*.toml text eol=lf

*.png binary
*.jpg binary
*.ico binary
